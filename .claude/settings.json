{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install)",
      "Bash(pnpm add *)",
      "Bash(pnpm remove *)",
      "Bash(pnpm run *)",
      "Bash(pnpm typecheck)",
      "Bash(pnpm lint)",
      "Bash(pnpm test)",
      "Bash(pnpm build)",
      "Bash(pnpm db:types)",
      "Bash(pnpm dlx shadcn@latest *)",
      "Bash(pnpm supabase start)",
      "Bash(pnpm supabase stop)",
      "Bash(pnpm supabase status)",
      "Bash(pnpm supabase migration new *)",
      "Bash(pnpm supabase db reset)",
      "Bash(pnpm supabase test db)",
      "Bash(pnpm supabase gen types *)",
      "Bash(git status)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Bash(gh *)",
      "Bash(git push *)",
      "Bash(git fetch *)",
      "Bash(git pull *)",
      "Bash(git switch *)",
      "Bash(git checkout *)",
      "Bash(git branch *)",
      "Bash(git merge *)",
      "Bash(git tag *)"
    ],
    "ask": [
      "Bash(pnpm supabase link *)",
      "Bash(pnpm supabase db push *)",
      "Bash(pnpm supabase db reset --linked *)",
      "Bash(git push --force*)",
      "Bash(git push -f*)",
      "Bash(gh repo delete*)",
      "Bash(gh release delete*)",
      "Bash(gh secret *)",
      "Bash(gh auth *)"
    ],
    "deny": ["Read(./.env)", "Read(./.env.*)"],
    "defaultMode": "plan"
  }
}
